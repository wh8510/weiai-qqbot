# Host-installed Caddy example.
# Install Caddy on the host, put your domain here, then:
#   sudo caddy run --config /etc/caddy/Caddyfile
#
# The bot only listens on 127.0.0.1:8080 (see docker-compose.yml), so Caddy
# on the host can reach it while the port stays closed to the internet.

bot.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}
