# Docker deployment template for Linux.
# Copy to the project root as `.env`:
#   cp deploy/.env.docker.example .env
#
# This assumes NapCat runs in Docker on the same host and exposes its
# WebSocket Server on port 3001.

BOT_HOST=127.0.0.1
BOT_PORT=8080
BOT_PUBLIC_URL=http://127.0.0.1:8080
BOT_DATA_DIR=/data
BOT_TRUST_PROXY=0
BOT_FORCE_HTTPS=0
BOT_TIMEZONE=Asia/Shanghai
BOT_CURRENCY=CNY

ONEBOT_MODE=forward
ONEBOT_URL=ws://host.docker.internal:3001
ONEBOT_PATH=/onebot/v11/ws
# Must match NapCat's WebSocket Server token.
ONEBOT_TOKEN=change-me-to-a-long-random-token

# Provider keys can be entered in the admin UI after first login.
