# ── 必填/首次启动 ──────────────────────────────────────────────
# 32 字节主密钥（base64 或 hex）。不填会自动生成 data/master.key。
# 部署到云端后请务必备份；丢失后加密数据库不可恢复。
# BOT_MASTER_KEY=

# 首次启动管理员密码；不填会自动生成并写入 data/initial-credentials.txt
# BOT_ADMIN_PASSWORD=
BOT_ADMIN_USERNAME=admin

# ── OneBot ────────────────────────────────────────────────────
# 反向 WS（推荐）：NapCat 作为客户端连过来
ONEBOT_MODE=reverse
ONEBOT_PATH=/onebot/v11/ws
ONEBOT_TOKEN=change-me-to-a-long-random-token
# 正向 WS 时才需要。Docker 部署且 NapCat 也在同一台宿主机时：
# ONEBOT_MODE=forward
# ONEBOT_URL=ws://host.docker.internal:3001
# 裸机 / 同机非 Docker：
# ONEBOT_URL=ws://127.0.0.1:3001
# ONEBOT_HTTP_URL=http://127.0.0.1:3000

# ── 服务 ──────────────────────────────────────────────────────
BOT_HOST=127.0.0.1
BOT_PORT=8080
BOT_PUBLIC_URL=http://127.0.0.1:8080
BOT_TIMEZONE=Asia/Shanghai
BOT_CURRENCY=CNY
# 生产环境放在 Caddy/Nginx 后面时设为 1
BOT_TRUST_PROXY=0

# ── 模型 Key（可选；也可以启动后在 Web 管理端填） ─────────────
# 程序首次启动会把这里的 key 写入对应 Provider（已存在则不覆盖），并启用 Provider。
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# MINIMAX_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Demo ──────────────────────────────────────────────────────
# DEMO_MODE=1
